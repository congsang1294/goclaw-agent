# ============================================================
# GOOGLE ADS TOOLKIT — TAO CREATIVE FB SKILL
# ============================================================
# Copy file này thành .env và điền các giá trị
# cp env.example .env

# --- OpenAI (BẮT BUỘC: gọi GPT Image API - gpt-image-1) ---
OPENAI_API_KEY=sk-proj-xxx

# --- OpenRouter (BẮT BUỘC: gọi model deepseek/deepseek-v4-flash viết caption) ---
OPENROUTER_API_KEY=sk-or-xxx

# --- Facebook Page (chạy auto_config.py để tự động lấy) ---
FB_PAGE_ID=
FB_PAGE_NAME=
FB_ACCESS_TOKEN=

# --- Image Upload (duy nhất VPS) ---
# Upload lên VPS web tĩnh → URL tool.congsang.info.vn/images/*
VPS_HOST=103.97.126.13
VPS_PORT=2018
VPS_USER=root
VPS_PASS=
VPS_IMAGE_DIR=/opt/my-website/google-ads-toolkit/images
VPS_BASE_URL=https://tool.congsang.info.vn/images

# --- Chế độ ---
# true  = giả lập (không gọi API FB thật, in ra console + lưu file local)
# false = đăng bài thật lên Facebook Page
DRY_RUN=true
