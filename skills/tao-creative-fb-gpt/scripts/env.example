# Copy file này thành .env ở cùng cấp với SKILL.md.
# Windows: Copy-Item scripts\env.example .env
# Linux:   cp scripts/env.example .env
#
# Trên GoClaw/VPS, nên inject biến vào container hoặc đặt trong /opt/goclaw/.env.
# Có thể đổi vị trí bằng GOCLAW_ENV_FILE.
# KHÔNG đưa key/token thật vào file này hoặc ZIP public.

# OpenAI — dùng chung cho sinh ảnh và caption/copy
OPENAI_API_KEY=sk-proj-replace-me
# Tương thích cấu hình cũ: nếu có, OPENAI_KEY_REAL được ưu tiên hơn.
# OPENAI_KEY_REAL=sk-proj-replace-me

# Model text dùng bởi gen_caption.py
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Facebook Page
FB_PAGE_ID=replace-with-page-id
FB_PAGE_TOKEN=replace-with-page-access-token

# Telegram — gửi preview ảnh về bot để duyệt trước khi đăng Facebook
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# Số điện thoại hiển thị trong CTA (mặc định 039 775 9119 nếu không set)
BUSINESS_PHONE=039 775 9119

# Phiên bản Graph API. Giữ cấu hình được để nâng cấp mà không sửa code.
FB_GRAPH_VERSION=v25.0
FB_TIMEOUT_SECONDS=90

# An toàn mặc định khi mới cài lên VPS:
# true  = không đăng Facebook; chỉ lưu ảnh, caption và preview local
# false = cho phép post thật sau khi user duyệt
DRY_RUN=true

# Brand context
# Local Windows ví dụ:
# BRAIN_DB_PATH=D:\AI21days\my-brain\brain.db
# CONTEXT_DIR=D:\AI21days\my-brain\context-files
#
# GoClaw/VPS ví dụ:
BRAIN_DB_PATH=/opt/mcp/brain.db
CONTEXT_DIR=/opt/mcp/context-files

# File dotenv chung của GoClaw nếu khác mặc định /opt/goclaw/.env
GOCLAW_ENV_FILE=/opt/goclaw/.env
