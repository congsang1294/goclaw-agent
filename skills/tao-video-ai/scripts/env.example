# Secrets for tao-video-ai. Do not commit.

# --- BẮT BUỘC (chọn 1 trong 2) ---
# Dùng OpenAI để gen prompt (khuyên dùng)
OPENAI_API_KEY=sk-proj-your-key-here

# Hoặc dùng Claude để gen prompt
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- KHÔNG BẮT BUỘC (Optional) ---
# Kling AI API — để upload + render tự động lên Kling
# Lấy tại: https://console.klingai.com
# KLING_API_KEY=
# KLING_SECRET_KEY=

# --- ĐƯỜNG DẪN ---
# Thư mục chứa ảnh sản phẩm (mặc định: product-photos/ trong project root)
# PRODUCT_PHOTOS_DIR=
